<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SwRefs</RootNamespace>
    <AssemblyName>SwRefs</AssemblyName>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    The SolidWorks Document Manager interop DLL (SolidWorks.Interop.swdocumentmgr.dll) is not
    redistributable and only exists on machines with SolidWorks installed. Point SWDM_INTEROP_PATH
    at it (as an environment variable or -p:SWDM_INTEROP_PATH=...) to compile the real reader.
    Without it the app builds with only the fake reader.
  -->
  <PropertyGroup Condition="'$(SWDM_INTEROP_PATH)' != ''">
    <DefineConstants>$(DefineConstants);SWDM</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(SWDM_INTEROP_PATH)' != ''">
    <Reference Include="SolidWorks.Interop.swdocumentmgr">
      <HintPath>$(SWDM_INTEROP_PATH)</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckSwdmInteropPath" BeforeTargets="ResolveAssemblyReferences" Condition="'$(SWDM_INTEROP_PATH)' != ''">
    <Error Condition="!Exists('$(SWDM_INTEROP_PATH)')" Text="SWDM_INTEROP_PATH is set but '$(SWDM_INTEROP_PATH)' does not exist." />
  </Target>

</Project>
