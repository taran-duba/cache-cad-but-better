{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Permafrost",
  "mainBinaryName": "permafrost",
  "version": "1.2.0",
  "identifier": "org.frc.cadsync",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Permafrost",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDODJGN0Q5NDk5QkZCOEYKUldTUCs1dEoyZmVDL0V2SThPNS9DWk9uZlRwUU9OdW05VUN0dUNtTzJKM05LQm1LVzliUXlIRGcK",
      "endpoints": [
        "https://github.com/taran-duba/permafrost/releases/latest/download/latest.json"
      ]
    }
  }
}
